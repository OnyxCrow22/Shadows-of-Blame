.settings-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(0, 12, 18, 0.92);
    justify-content: center;
    align-items: center;
}

.settings-panel {
    width: 700px;
    flex-direction: column;
    background-color: #131A24;
    padding: 24px;
    gap: 16px;
    border-left-width: 4px;
    border-left-color: #00E5FF;
    border-radius: 4px;
}

.settings-tabs {
    flex-direction: row;
    gap: 8px;
    margin-bottom: 12px;
}

.settings-tab {
    flex-grow: 1;
    height: 44px;
    background-color: #1C2531;
    color: #7A8A9A;
}

.settings-tab-active {
    background-color: #00E5FF;
    color: #0A0E14;
}

.settings-page {
    flex-direction: column;
    gap: 12px;
    padding: 12px 0;
}

.settings-label {
    color: #C0CEDD;
    font-size: 14px;
    margin-top: 8px;
}

.settings-slider {
    width: 100%;
    height: 20px;
}

.settings-dropdown {
    width: 100%;
    height: 40px;
}

.settings-toggle {
    margin-top: 8px;
}

.hidden {
    display: none;
}