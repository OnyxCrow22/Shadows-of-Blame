<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/Utility/UI/SettingsMenu.uss?fileID=7433441132597879392&amp;guid=155d15b130c57b446afc2874e7f6787e&amp;type=3#SettingsMenu"/>
    <ui:VisualElement name="ButtonHolder" style="flex-grow: 0; flex-direction: row; width: auto; height: 50px;">
        <ui:Button text="Graphics" name="graphicsButton" style="width: 104px; height: 29px;"/>
        <ui:Button text="Gameplay" name="gameplayButton" style="width: 104px; height: 29px;"/>
        <ui:Button text="HUD" name="hudButton" style="width: 104px; height: 29px;"/>
        <ui:Button text="Audio" name="audioButton" style="width: 104px; height: 29px;"/>
    </ui:VisualElement>
    <ui:VisualElement name="ContentArea" style="flex-grow: 1; width: auto; height: auto;">
        <ui:VisualElement name="GraphicsSettings" style="flex-grow: 1; width: 100%; height: 100%;">
            <ui:Slider label="Motion Blur" value="0" high-value="100"/>
        </ui:VisualElement>
    </ui:VisualElement>
